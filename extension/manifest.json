{
  "manifest_version": 3,
  "name": "WEBCAT",
  "version": "3.0.0",
  "browser_specific_settings": {
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "gecko": {
      "id": "webcat@freedom.press",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "incognito": "spanning",
  "permissions": [
    "alarms",
    "browsingData",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "webRequestFilterResponse.serviceWorkerScript",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/webcat.SVG",
    "32": "icons/webcat.SVG",
    "48": "icons/webcat.SVG",
    "64": "icons/webcat.SVG",
    "96": "icons/webcat.SVG",
    "128": "icons/webcat.SVG",
    "256": "icons/webcat.SVG"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "scripts": ["dist/bundle.js"]
  },
  "page_action": {
    "default_icon": {
      "48": "icons/webcat.SVG",
      "128": "icons/webcat.SVG"
    },
    "default_title": "__MSG_WEBCAT_webcatNotEnrolled__",
    "default_popup": "pages/popup.html",
    "show_matches": ["*://*/*"]
  },
  "default_locale": "en"
}
