{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["firefox-webext-browser", "vite/client", "node"],
    "resolveJsonModule": true,
    "outDir": "./dist/lib",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "./src/*/**/*.ts",
    "./types/**/*.d.ts",
    "./src/webcat.ts",
    "./src/config.ts"
  ],
  "exclude": ["node_modules", "src/webcat/hooks", "src/mocks"]
}
