{
  "entryPoints": [
    "src/config.ts",
    "src/webcat.ts",
    "src/browser/**/*.ts",
    "src/webcat/**/*.ts"
  ],
  "exclude": ["src/webcat/hooks/*.ts"],
  "intentionallyNotExported": [
    "browser.webRequest._OnBeforeRequestDetails",
    "browser.webRequest._OnHeadersReceivedDetails"
  ],
  "externalSymbolLinkMappings": {
    "typescript": {
      "Disposable": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/using"
    },
    "@types/firefox-webext-browser": {
      "browser.storage": "https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/storage",
      "browser.storage.StorageArea": "https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/storage/StorageArea"
    }
  },
  "ignoredHighlightLanguages": ["mermaid"],
  "plugin": ["@boneskull/typedoc-plugin-mermaid"],
  "mermaidSource": "local",
  "excludeInternal": true,
  "out": "../api",
  "displayBasePath": "src"
}
