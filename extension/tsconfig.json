{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["firefox-webext-browser", "vite/client", "node"],
    "resolveJsonModule": true,
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["./src/**/*.ts", "./types/**/*.d.ts"],
  "exclude": ["node_modules", "src/webcat/hooks"]
}
