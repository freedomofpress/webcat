{
  "name": "webcat",
  "type": "module",
  "version": "2.7.1",
  "description": "",
  "files": [
    "dist/lib",
    "dist/hooks/content.js",
    "data",
    "icons",
    "pages"
  ],
  "exports": {
    ".": "./dist/lib/webcat.js",
    "./config": "./dist/lib/config.js",
    "./webcat/*": "./dist/lib/webcat/*.js",
    "./hooks/*": "./dist/hooks/*",
    "./browser/*": "./dist/lib/browser/*.js",
    "./validator_set": "./dist/lib/validator_set.js",
    "./data/*.json": "./data/*.json",
    "./icons/light/*.SVG": "./icons/light/*.SVG",
    "./icons/dark/*.SVG": "./icons/dark/*.SVG",
    "./pages/*": "./pages/*"
  },
  "scripts": {
    "build:hooks": "tsc -p tsconfig.hooks.json && vite build --config vite.config.hooks.page.ts && vite build --config vite.config.hooks.content.ts",
    "build:lib": "npm run build:hooks && vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && cp src/validator_set.d.ts dist/lib/validator_set.d.ts",
    "build": "npm run build:hooks && tsc && vite build",
    "prepack": "npm run build:lib",
    "test": "npm run build:hooks && vitest",
    "coverage": "npm run build:hooks && vitest --coverage",
    "test:playwright": "vitest --config vite.config.playwright.ts",
    "test:default": "vitest --config vite.config.ts",
    "lint": "dpdm src/background.ts --no-warning --no-tree --exit-code circular:1 && npx eslint . --fix && npx prettier --write .",
    "lint:check": "dpdm src/background.ts --no-warning --no-tree --exit-code circular:1 && npx eslint . && npx prettier --check ."
  },
  "author": "Giulio B",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/firefox": "^0.0.34",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.1.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "dpdm": "^4.2.0",
    "eslint": "^10.4.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.8",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@freedomofpress/cometbft": "^0.1.4",
    "@freedomofpress/ics23": "^0.1.3",
    "@freedomofpress/sigstore-browser": "^0.1.13",
    "@freedomofpress/sigsum": "^0.3.7"
  }
}
